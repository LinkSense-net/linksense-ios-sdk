// Copy this file to Secrets.xcconfig and fill in real values.
// Secrets.xcconfig is git-ignored; keep it local to your machine.
//
// Parity with Android sample's local.properties:
//   linksense.sdkKey       → LINKSENSE_SDK_KEY
//   linksense.appLinkHost  → LINKSENSE_APP_LINK_HOST

// Publishable SDK key — format ls_sdk_<project>_<random>.
LINKSENSE_SDK_KEY = ls_sdk_TODO_SET_LINKSENSE_SDK_KEY_in_Secrets_xcconfig

// Host used for Universal Links (applinks:<host>). Won't round-trip until you
// serve a matching apple-app-site-association on that host.
LINKSENSE_APP_LINK_HOST = example.invalid
